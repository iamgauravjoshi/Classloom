{
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Database and Redis connectivity",
        "tags": [
          "health"
        ]
      }
    },
    "/schools/code-availability": {
      "get": {
        "operationId": "getCodeAvailability",
        "parameters": [
          {
            "name": "code",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeAvailabilityResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "More than 60 checks per minute from this address"
          }
        },
        "summary": "Check a school code",
        "tags": [
          "schools"
        ]
      }
    },
    "/schools/{code}/public": {
      "get": {
        "operationId": "getPublicSchool",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSchoolDto"
                }
              }
            }
          },
          "404": {
            "description": "No active school with this code"
          }
        },
        "summary": "Public profile of an active school",
        "tags": [
          "schools"
        ]
      }
    },
    "/school-registrations": {
      "post": {
        "operationId": "createSchoolRegistration",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchoolRegistrationRequestDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchoolRegistrationAcceptedDto"
                }
              }
            }
          },
          "409": {
            "description": "The school code is already taken"
          },
          "429": {
            "description": "Too many registrations from this address"
          }
        },
        "summary": "Register a school and email a verification link",
        "tags": [
          "school-registrations"
        ]
      }
    },
    "/school-registrations/resend": {
      "post": {
        "operationId": "resendSchoolRegistration",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendRegistrationRequestDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted whether or not a matching registration exists"
          },
          "429": {
            "description": "More than 3 resends in an hour for one email and code, or too many from this address"
          }
        },
        "summary": "Email a new verification link; always 202",
        "tags": [
          "school-registrations"
        ]
      }
    },
    "/school-registrations/cancel": {
      "post": {
        "operationId": "cancelSchoolRegistration",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRegistrationRequestDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Withdrawn if the token matches a pending registration; otherwise nothing changes"
          },
          "429": {
            "description": "Too many requests from this address"
          }
        },
        "summary": "Withdraw a pending registration (\"Use a different email\"); always 204",
        "tags": [
          "school-registrations"
        ]
      }
    },
    "/school-registrations/verify": {
      "post": {
        "operationId": "verifySchoolRegistration",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRegistrationRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyRegistrationResponseDto"
                }
              }
            }
          },
          "410": {
            "description": "The link is unknown, used or expired"
          }
        },
        "summary": "Verify a school registration",
        "tags": [
          "school-registrations"
        ]
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "The signed-in user, school and role",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sign-out": {
      "post": {
        "operationId": "signOut",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Signed out, also when there was no session"
          }
        },
        "summary": "End the current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sign-in/password": {
      "post": {
        "operationId": "signInWithPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordSignInRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            }
          },
          "401": {
            "description": "Email/mobile or password is incorrect."
          },
          "429": {
            "description": "Paused after 5 wrong passwords (type sign-in-paused), or too many from this address"
          }
        },
        "summary": "Sign in to a school with an email or mobile and a password",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/otp/request": {
      "post": {
        "operationId": "requestSignInCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeRequestDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeRequestAcceptedDto"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this address"
          },
          "503": {
            "description": "The queue is unreachable"
          }
        },
        "summary": "Email a 6-digit sign-in code (the answer is the same whether or not the account exists)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/otp/verify": {
      "post": {
        "operationId": "verifySignInCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeVerifyRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            }
          },
          "401": {
            "description": "That code is incorrect or has expired."
          },
          "429": {
            "description": "Too many attempts from this address"
          }
        },
        "summary": "Sign in to a school with an emailed code",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/password/forgot": {
      "post": {
        "operationId": "requestPasswordReset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequestDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted; a link is emailed if an account matches."
          },
          "400": {
            "description": "The identifier is not an email or a mobile number"
          },
          "429": {
            "description": "Too many requests from this address"
          },
          "503": {
            "description": "The queue is unreachable"
          }
        },
        "summary": "Email a password reset link (the answer is the same whether or not the account exists)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/password/reset": {
      "post": {
        "operationId": "resetPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequestDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The password was changed."
          },
          "400": {
            "description": "The new password breaks the policy (errors[] with path newPassword and a code)"
          },
          "410": {
            "description": "The link is unknown, expired or already used"
          }
        },
        "summary": "Set a new password with a reset link token; signs everyone out and does not sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "The signed-in user",
        "tags": [
          "me"
        ]
      },
      "patch": {
        "operationId": "updateMe",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          },
          "400": {
            "description": "The name or mobile is not valid"
          },
          "401": {
            "description": "No valid session"
          },
          "409": {
            "description": "The mobile belongs to another account (errors[] path mobile)"
          },
          "429": {
            "description": "More than 20 changes in an hour"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Change your name or mobile number (null clears the mobile); 20 changes per hour",
        "tags": [
          "me"
        ]
      }
    },
    "/me/password": {
      "put": {
        "operationId": "setPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetPasswordRequestDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The password was saved."
          },
          "400": {
            "description": "The current password is missing or wrong (path currentPassword), or the new one breaks the policy (path newPassword)"
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "First set without a sign-in in the last 10 minutes (type recent-sign-in-required)"
          },
          "429": {
            "description": "Password attempts are paused (type sign-in-paused)"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Set a first password or change it; signs out your other sessions",
        "tags": [
          "me"
        ]
      }
    }
  },
  "info": {
    "title": "Classloom API",
    "description": "Multi-school management SaaS for Indian schools",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cl_session"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "redis": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              }
            },
            "required": [
              "database",
              "redis"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "CodeAvailabilityResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "taken",
              "reserved",
              "invalid"
            ]
          },
          "suggestion": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "available"
        ]
      },
      "PublicSchoolDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "AN",
              "AP",
              "AR",
              "AS",
              "BR",
              "CG",
              "CH",
              "DH",
              "DL",
              "GA",
              "GJ",
              "HP",
              "HR",
              "JH",
              "JK",
              "KA",
              "KL",
              "LA",
              "LD",
              "MH",
              "ML",
              "MN",
              "MP",
              "MZ",
              "NL",
              "OD",
              "PB",
              "PY",
              "RJ",
              "SK",
              "TN",
              "TR",
              "TG",
              "UK",
              "UP",
              "WB"
            ]
          }
        },
        "required": [
          "code",
          "name",
          "city",
          "state"
        ]
      },
      "SchoolRegistrationRequestDto": {
        "type": "object",
        "properties": {
          "schoolName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "board": {
            "type": "string",
            "enum": [
              "CBSE",
              "ICSE",
              "STATE",
              "IB",
              "CAMBRIDGE",
              "OTHER"
            ]
          },
          "city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "state": {
            "type": "string",
            "enum": [
              "AN",
              "AP",
              "AR",
              "AS",
              "BR",
              "CG",
              "CH",
              "DH",
              "DL",
              "GA",
              "GJ",
              "HP",
              "HR",
              "JH",
              "JK",
              "KA",
              "KL",
              "LA",
              "LD",
              "MH",
              "ML",
              "MN",
              "MP",
              "MZ",
              "NL",
              "OD",
              "PB",
              "PY",
              "RJ",
              "SK",
              "TN",
              "TR",
              "TG",
              "UK",
              "UP",
              "WB"
            ]
          },
          "code": {
            "type": "string"
          },
          "adminName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "mobile": {
            "type": "string"
          },
          "acceptTerms": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "schoolName",
          "board",
          "city",
          "state",
          "code",
          "adminName",
          "email",
          "acceptTerms"
        ]
      },
      "SchoolRegistrationAcceptedDto": {
        "type": "object",
        "properties": {
          "maskedEmail": {
            "type": "string"
          },
          "cancelToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "maskedEmail",
          "cancelToken"
        ]
      },
      "ResendRegistrationRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "CancelRegistrationRequestDto": {
        "type": "object",
        "properties": {
          "cancelToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "cancelToken"
        ]
      },
      "VerifyRegistrationRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "token"
        ]
      },
      "VerifyRegistrationResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "AuthSessionDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "mobile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hasPassword": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "mobile",
              "hasPassword"
            ]
          },
          "school": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "code",
              "name"
            ]
          },
          "campus": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "role": {
            "type": "string",
            "const": "OWNER"
          },
          "remember": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "user",
          "school",
          "campus",
          "role",
          "remember",
          "expiresAt"
        ]
      },
      "PasswordSignInRequestDto": {
        "type": "object",
        "properties": {
          "schoolCode": {
            "type": "string"
          },
          "identifier": {
            "type": "string",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "remember": {
            "type": "boolean"
          }
        },
        "required": [
          "schoolCode",
          "identifier",
          "password",
          "remember"
        ]
      },
      "CodeRequestDto": {
        "type": "object",
        "properties": {
          "schoolCode": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "maxLength": 254
          }
        },
        "required": [
          "schoolCode",
          "email"
        ]
      },
      "CodeRequestAcceptedDto": {
        "type": "object",
        "properties": {
          "maskedEmail": {
            "type": "string"
          }
        },
        "required": [
          "maskedEmail"
        ]
      },
      "CodeVerifyRequestDto": {
        "type": "object",
        "properties": {
          "schoolCode": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "code": {
            "type": "string"
          },
          "remember": {
            "type": "boolean"
          }
        },
        "required": [
          "schoolCode",
          "email",
          "code",
          "remember"
        ]
      },
      "ForgotPasswordRequestDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "maxLength": 254
          }
        },
        "required": [
          "identifier"
        ]
      },
      "ResetPasswordRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
