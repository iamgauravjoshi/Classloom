// Tenancy: schools (tenants), their campuses, global user identities and memberships.
// Spec: docs/superpowers/specs/2026-10-26-tenancy-design.md, sections 4 and 5.
//
// Tenant-owned models (those with a `tenantId` field) must be listed in TENANT_SCOPED_MODELS
// (src/core/tenancy/tenant-scoped-models.ts) and have a row-level security policy in their
// migration. A unit test fails if a model with `tenantId` is missing from the registry.

/// Values match BOARDS in @classloom/contracts.
enum Board {
  CBSE
  ICSE
  STATE
  IB
  CAMBRIDGE
  OTHER
}

/// ISO 3166-2:IN codes; values match INDIAN_STATES in @classloom/contracts.
enum IndianState {
  AN
  AP
  AR
  AS
  BR
  CG
  CH
  DH
  DL
  GA
  GJ
  HP
  HR
  JH
  JK
  KA
  KL
  LA
  LD
  MH
  ML
  MN
  MP
  MZ
  NL
  OD
  PB
  PY
  RJ
  SK
  TN
  TR
  TG
  UK
  UP
  WB
}

enum TenantStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CampusStatus {
  ACTIVE
  INACTIVE
}

/// REVOKED is the registration cancel path; DEACTIVATED is reversible (spec Part 3, section 6).
enum MembershipStatus {
  ACTIVE
  REVOKED
  DEACTIVATED
}

/// A school. Platform-level: not row-level secured.
model Tenant {
  id              String       @id @default(uuid(7)) @db.Uuid
  /// Case-insensitive; stored uppercase.
  code            String       @unique @db.Citext
  name            String
  board           Board
  city            String
  state           IndianState
  contactEmail    String       @map("contact_email") @db.Citext
  status          TenantStatus @default(PENDING_VERIFICATION)
  verifiedAt      DateTime?    @map("verified_at") @db.Timestamptz(6)
  suspendedAt     DateTime?    @map("suspended_at") @db.Timestamptz(6)
  termsAcceptedAt DateTime     @map("terms_accepted_at") @db.Timestamptz(6)
  /// SHA-256 of the token that lets the registering browser withdraw the school while it is
  /// still pending ("Use a different email"); cleared on verification.
  cancelTokenHash Bytes?       @unique @map("cancel_token_hash")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  campuses           Campus[]
  memberships        Membership[]
  registrationTokens RegistrationToken[]
  sessions           Session[]
  authEvents         AuthEvent[]
  roles              Role[]
  rolePermissions    RolePermission[]
  membershipRoles    MembershipRole[]
  invitations        Invitation[]
  auditEvents        AuditEvent[]

  @@map("tenants")
}

/// Tenant-owned, row-level secured. Exactly one primary campus per tenant (partial unique
/// index `campuses_one_primary`, added in the migration SQL).
model Campus {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  isPrimary Boolean      @default(false) @map("is_primary")
  city      String
  state     IndianState
  status    CampusStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("campuses")
}

/// A global identity. Platform-level: not row-level secured.
model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  email             String    @unique @db.Citext
  name              String
  /// E.164. Unique where not null (partial index `users_mobile_key`, added in the migration SQL).
  mobile            String?
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// argon2id encoded string; null until the user sets a password.
  passwordHash      String?   @map("password_hash")
  /// Set whenever the password is set, changed or reset.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  /// AES-256-GCM ciphertext (IV + tag + data) of the base32 TOTP secret; null when two-step is off.
  totpSecretEnc     Bytes?    @map("totp_secret_enc")
  /// Set when two-step sign-in is turned on; null when off.
  totpEnabledAt     DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  /// The last accepted 30-second time step; a code from that step or earlier is refused (replay).
  totpLastStep      BigInt?   @map("totp_last_step")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  sessions    Session[]
  authEvents  AuthEvent[]

  recoveryCodes RecoveryCode[]
  knownDevices  KnownDevice[]

  @@map("users")
}

/// Tenant-owned, row-level secured. What a member may do comes from their roles
/// (`membership_roles`, see iam.prisma).
model Membership {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  status        MembershipStatus @default(ACTIVE)
  /// Set when the membership is deactivated; cleared when it is reactivated.
  deactivatedAt DateTime?        @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]
  roles    MembershipRole[]

  @@unique([tenantId, userId])
  /// Target of membership_roles' composite foreign key (keeps it inside one school).
  @@unique([id, tenantId])
  @@index([userId])
  @@map("memberships")
}

/// Email verification token for a pending registration. Platform-level: not row-level
/// secured (it is read before any tenant context exists), so it is exempt from
/// TENANT_SCOPED_MODELS via PLATFORM_MODELS_WITH_TENANT_FK.
model RegistrationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  /// SHA-256 of the raw token; the raw token exists only in the email link.
  tokenHash Bytes     @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("registration_tokens")
}
