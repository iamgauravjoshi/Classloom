# Copy to .env for local development. Never commit .env.
NODE_ENV=development

# Postgres (docker/compose.yml)
POSTGRES_USER=classloom
POSTGRES_PASSWORD=classloom
POSTGRES_DB=classloom
DATABASE_URL=postgresql://classloom:classloom@localhost:5432/classloom

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible storage (RustFS locally; console on http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=classloom
S3_SECRET_KEY=classloom-secret
S3_BUCKET=classloom-dev

# Email (Mailpit locally: UI on http://localhost:8025)
SMTP_URL=smtp://localhost:1025

# PDF rendering
GOTENBERG_URL=http://localhost:3001

# Apps
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
