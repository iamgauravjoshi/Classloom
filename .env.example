# Copy to .env for local development. Never commit .env.
NODE_ENV=development

# Postgres (docker/compose.yml)
POSTGRES_USER=classloom
POSTGRES_PASSWORD=classloom
POSTGRES_DB=classloom
# Runtime connection: restricted role, subject to row-level security.
DATABASE_URL=postgresql://classloom_app:classloom_app@localhost:5432/classloom
# Owner role (see docker/postgres/init/01-roles.sql): migrations and the platform CLI only.
# The API does not need it; it purges expired registrations through a SECURITY DEFINER function.
DATABASE_MIGRATION_URL=postgresql://classloom_owner:classloom_owner@localhost:5432/classloom

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible storage (RustFS locally; console on http://localhost:9001). The API creates the
# bucket on startup when it is missing; while storage is down only uploads and logos fail.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=classloom
S3_SECRET_KEY=classloom-secret
S3_BUCKET=classloom-dev
# Path-style URLs (<endpoint>/<bucket>/<key>), which RustFS needs (default: true)
S3_FORCE_PATH_STYLE=true

# Email (Mailpit locally: UI on http://localhost:8025)
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="Classloom <no-reply@classloom.local>"

# PDF rendering
GOTENBERG_URL=http://localhost:3001

# Apps
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Public-endpoint throttles (the E2E suite raises them; the defaults suit production)
REGISTRATION_RATE_LIMIT_PER_HOUR=5
CODE_AVAILABILITY_RATE_LIMIT_PER_MINUTE=60
# Per client address, on resend and on cancel
RESEND_RATE_LIMIT_PER_HOUR=10

# Web: where the server and the /api rewrite reach the API. The rewrite is fixed when the web app
# is built, so set this for `pnpm build` too, not only at start.
API_INTERNAL_URL=http://localhost:4000

# Auth (API)
# HMAC key for sign-in codes and identifier hashes; at least 32 characters. Use a long random
# value outside local development (for example: openssl rand -base64 48).
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789
# AES-256-GCM key for two-step secrets: base64 of exactly 32 bytes. The value below is DEV ONLY and
# is refused when NODE_ENV=production. Generate one with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktdG90cC1rZXktMDEyMzQ1LWFiY2RlZmc=
# Defaults to true when NODE_ENV=production, false otherwise
# COOKIE_SECURE=true
# Express trust proxy value, so rate limits see the browser address (default: loopback)
# TRUST_PROXY=loopback
# Sign-in throttles per client address (the E2E suite raises them; the defaults suit production)
SIGN_IN_RATE_LIMIT_PER_15_MIN=30
CODE_REQUEST_RATE_LIMIT_PER_HOUR=10
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=10
